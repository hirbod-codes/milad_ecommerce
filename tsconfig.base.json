{
    "buildOptions": {
        "verbose": true
    },
    "compilerOptions": {
        "target": "ES2022",
        "module": "commonjs",
        "lib": [
            "ES2022"
        ],
        "strict": true,
        "esModuleInterop": true,
        "moduleResolution": "node",
        "baseUrl": ".",
        "paths": {
            "@utils/*": [
                "packages/utils/src/*"
            ],
            "@mongodb/*": [
                "packages/mongodb/src/*"
            ]
        },
        "typeRoots": [
            "./node_modules",
            "./node_modules/@types"
        ],
        "types": [
            "node"
        ]
    }
}