{
    "name": "monorepo",
    "version": "1.0.0",
    "private": true,
    "keywords": [],
    "author": "",
    "description": "",
    "workspaces": [
        "backend/*",
        "frontend/*",
        "packages/*"
    ],
    "scripts": {
        "build": "npm run build --workspaces",
        "build:api": "tsc -p ./backend/api/tsconfig.json",
        "build:authorization": "tsc -p ./backend/authorization/tsconfig.json",
        "build:zscore-maintainer": "tsc -p ./backend/zscore-maintainer/tsconfig.json",
        "build:web": "vite build --config ./frontend/web/vite.config.ts",
        "build:utils": "tsc -p ./packages/utils/tsconfig.json",
        "build:mongodb": "tsc -p ./packages/mongodb/tsconfig.json",
        "dev:api": "npm run dev --workspace=api",
        "dev:authorization": "npm run dev --workspace=authorization",
        "dev:zscore-maintainer": "npm run dev --workspace=zscore-maintainer",
        "dev:web": "npm run dev --workspace=web"
    }
}