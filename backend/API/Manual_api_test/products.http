###
GET http://localhost:3000/products/{{productId}} HTTP/1.1
Accept: application/json

###
GET http://localhost:3000/products HTTP/1.1
Accept: application/json

###
GET http://localhost:3000/products?filter={"$or":[{"name":"name1"},{"name":"name2"}]} HTTP/1.1
Accept: application/json

###
PATCH http://localhost:3000/products HTTP/1.1
Authorization: Bearer {{accessToken}}
Content-Type: application/json
Accept: application/json

{
    "id": "{{productId}}",
    "product": {
        "description": {
            "en": "description2"
        }
    }
}

###
PATCH http://localhost:3000/products/immutables HTTP/1.1
Authorization: Bearer {{accessToken}}
Content-Type: application/json
Accept: application/json

{
    "id": "{{productId}}",
    "product": {
        "views": 15
    }
}

###
DELETE http://localhost:3000/products HTTP/1.1
Authorization: Bearer {{accessToken}}
Content-Type: application/json
Accept: application/json

{
    "id": "{{productId}}"
}
