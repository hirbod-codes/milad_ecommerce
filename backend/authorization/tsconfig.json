{
    "extends": "../../tsconfig.base.json",
    "include": [
        "src"
    ],
    "compilerOptions": {
        "rootDir": "src",
        "baseUrl": "src",
        "outDir": "./dist",
        "noImplicitAny": false,
        "forceConsistentCasingInFileNames": true,
        "preserveWatchOutput": false,
        "declaration": true,
        "paths": {
            "@/*": [
                "*"
            ]
        }
    }
}